{
  "name": "@aubtown/control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "A governed, durable software factory with GitHub Issues as its canonical queue.",
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && npm run build:broker",
    "build:broker": "go build -trimpath -o dist/factory-coordinator ./cmd/factory-coordinator",
    "release:bundle": "npm run build && node dist/cli/build-release-bundle.js",
    "release:verify-install": "node dist/cli/verify-release-install.js",
    "check": "npm run typecheck && npm test && npm run test:broker",
    "check:symphony": "node scripts/check-symphony-upstream.mjs",
    "check:symphony:upstream": "node scripts/check-symphony-upstream.mjs --network",
    "github:refresh-token": "tsx src/cli/refresh-github-token.ts",
    "symphony:active-guard": "tsx src/cli/symphony-active-run-guard.ts",
    "symphony:prelaunch": "tsx src/cli/symphony-prelaunch.ts",
    "symphony:prepare-workspace": "tsx src/cli/prepare-symphony-workspace.ts",
    "symphony:complete-workspace": "tsx src/cli/complete-symphony-workspace.ts",
    "symphony:read-completion": "tsx src/cli/read-symphony-completion.ts",
    "symphony:publish-candidate": "tsx src/cli/publish-symphony-candidate.ts",
    "symphony:reconcile-candidate": "tsx src/cli/reconcile-symphony-candidate.ts",
    "symphony:reconcile-completion": "tsx src/cli/reconcile-symphony-completion.ts",
    "symphony:adjudicate-completion": "tsx src/cli/adjudicate-symphony-completion.ts",
    "symphony:publish-draft-local": "tsx src/cli/publish-draft-local.ts",
    "publisher:ssh-gateway": "tsx src/cli/publisher-ssh-gateway.ts",
    "host:monitor": "tsx src/host-monitor.ts",
    "pilot:audit": "tsx src/cli/audit-pilot-readiness.ts",
    "pilot:probe-executor": "tsx src/cli/probe-executor-readiness.ts",
    "pilot:probe-publisher": "tsx src/cli/probe-publisher-readiness.ts",
    "planning:collect": "tsx src/cli/collect-planning-snapshot.ts",
    "custody:plan": "tsx src/cli/plan-custody-transfer.ts",
    "freed:broker-conformance": "tsx src/cli/verify-freed-broker.ts",
    "freed:reconcile-claims": "tsx src/cli/reconcile-freed-claims.ts",
    "shadow": "tsx src/cli/shadow.ts",
    "shadow:github": "tsx src/cli/shadow-github.ts",
    "test": "vitest run",
    "test:broker": "go test ./...",
    "test:native-deployment": "vitest run test/native-deployment.test.ts test/network-config.test.ts",
    "test:pilot-readiness": "vitest run test/pilot-readiness.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1110.0",
    "@noble/ciphers": "2.3.0",
    "@octokit/auth-app": "8.3.0",
    "@octokit/rest": "22.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
