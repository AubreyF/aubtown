CODEX_HOME=/var/lib/aubtown/executor/codex
AUBTOWN_ACCOUNT_ID=codex-pro-1
AUBTOWN_CODEX_EFFORT=high
AUBTOWN_CODEX_EXECUTABLE=/opt/aubtown/bin/codex
AUBTOWN_CODEX_MODEL=replace-with-advertised-callable-model
AUBTOWN_CODEX_VERSION=replace-with-exact-codex-version-output
AUBTOWN_HOST_GATEWAY_URL=http://127.0.0.1:8090
AUBTOWN_GIT_EXECUTABLE=/usr/bin/git
AUBTOWN_EXECUTION_JOURNAL_FILE=/var/lib/aubtown/executor/execution.json
AUBTOWN_ADJUDICATION_JOURNAL_FILE=/var/lib/aubtown/executor/adjudication.json
AUBTOWN_VALIDATION_PATH=/opt/aubtown/node/bin:/usr/bin:/bin
AUBTOWN_CHECKPOINT_EDGE_URL=http://127.0.0.1:8081
AUBTOWN_CHECKPOINT_KEY_FILE=/etc/aubtown/keys/checkpoint-key.bin
AUBTOWN_CHECKPOINT_KEY_REFERENCE=pilot:checkpoint-v1
AUBTOWN_CHECKPOINT_LOCAL_STORE_ROOT=/var/lib/aubtown/executor/checkpoints
AUBTOWN_HOST_ID=linux-control-1
AUBTOWN_HOST_LANE=linux
AUBTOWN_HOST_PRIVATE_KEY_FILE=/etc/aubtown/keys/linux-host-private.pem
AUBTOWN_HOST_SEQUENCE_FILE=/var/lib/aubtown/executor/host-envelope.sequence
AUBTOWN_QUOTA_SAMPLE_SECONDS=60
FREED_REPOSITORY_ROOT=/srv/freed
AUBTOWN_WORKTREE_HELPER=/srv/freed/scripts/worktree-add.sh
AUBTOWN_WORKTREE_ROOT=/var/lib/aubtown/workspaces
