[Unit]
Description=AubTown encrypted checkpoint edge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=aubtown-checkpoint
Group=aubtown-checkpoint
WorkingDirectory=/opt/aubtown/current
EnvironmentFile=/etc/aubtown/checkpoint-edge.env
ExecStart=/usr/bin/env PORT=8091 AUBTOWN_BIND_HOST=127.0.0.1 AUBTOWN_CHECKPOINT_STORE_ROOT=/var/lib/aubtown/checkpoints /opt/aubtown/node/bin/node /opt/aubtown/current/dist/checkpoint-edge.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=aubtown/checkpoints
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aubtown/checkpoints
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
