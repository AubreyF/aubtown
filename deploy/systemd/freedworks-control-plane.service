[Unit]
Description=Freedworks durable control plane
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/freedworks/current
EnvironmentFile=/etc/freedworks/control-plane.env
ExecStart=/usr/bin/docker compose -f deploy/compose.yaml -f deploy/compose.production.yaml up -d --remove-orphans
ExecReload=/usr/bin/docker compose -f deploy/compose.yaml -f deploy/compose.production.yaml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f deploy/compose.yaml -f deploy/compose.production.yaml stop
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
