[Unit]
Description=Freedworks encrypted checkpoint edge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=freedworks-checkpoint
Group=freedworks-checkpoint
WorkingDirectory=/opt/freedworks/current
EnvironmentFile=/etc/freedworks/checkpoint-edge.env
ExecStart=/usr/bin/env PORT=8091 FREEDWORKS_BIND_HOST=127.0.0.1 FREEDWORKS_CHECKPOINT_STORE_ROOT=/var/lib/freedworks/checkpoints /opt/freedworks/node/bin/node /opt/freedworks/current/dist/checkpoint-edge.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=freedworks/checkpoints
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/freedworks/checkpoints
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
