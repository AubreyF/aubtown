[Unit]
Description=FreedTown signed host and quota monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=aubtown-symphony
Group=aubtown-symphony
WorkingDirectory=/opt/aubtown/current
EnvironmentFile=/etc/aubtown/host-agent.env
ExecStart=/opt/aubtown/node/bin/node /opt/aubtown/current/dist/host-monitor.js
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/aubtown
UMask=0077

[Install]
WantedBy=multi-user.target
