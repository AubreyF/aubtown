[Unit]
Description=AubTown signed host ingress edge
Requires=aubtown-restate.service
After=network-online.target aubtown-restate.service

[Service]
Type=simple
User=aubtown-edge
Group=aubtown-edge
WorkingDirectory=/opt/aubtown/current
ExecStart=/usr/bin/env PORT=8090 AUBTOWN_BIND_HOST=127.0.0.1 AUBTOWN_RESTATE_INGRESS=http://127.0.0.1:8080 /opt/aubtown/node/bin/node /opt/aubtown/current/dist/edge-gateway.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
