[Unit]
Description=AubTown Symphony coordinator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=aubtown-symphony
Group=aubtown-symphony
WorkingDirectory=/var/lib/aubtown/symphony
EnvironmentFile=/etc/aubtown/symphony.env
ExecStart=/opt/aubtown/symphony/8001b52e3062495a16e520e4ceaf8f9de868c4d0/symphony --i-understand-that-this-will-be-running-without-the-usual-guardrails --logs-root /var/log/aubtown/symphony --port 7080 /etc/aubtown/WORKFLOW.md
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
StateDirectory=aubtown/symphony aubtown/workspaces
StateDirectoryMode=0700
LogsDirectory=aubtown/symphony
LogsDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/aubtown
ReadWritePaths=/var/lib/aubtown/symphony /var/lib/aubtown/workspaces /var/log/aubtown/symphony
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
