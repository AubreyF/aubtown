[Unit]
Description=FreedTown coordinator
Wants=network-online.target
Requires=aubtown-github-token.service aubtown-host-gateway.service
After=network-online.target aubtown-github-token.service aubtown-host-gateway.service

[Service]
Type=simple
User=aubtown-symphony
Group=aubtown-symphony
WorkingDirectory=/var/lib/aubtown/symphony
EnvironmentFile=/etc/aubtown/symphony.env
Environment="PATH=/opt/aubtown/beam/.elixir-install/installs/otp/28.5.0.5/bin:/opt/aubtown/node/bin:/opt/aubtown/bin:/usr/local/bin:/usr/bin:/bin"
ExecStartPre=/opt/aubtown/node/bin/node /opt/aubtown/current/dist/cli/reconcile-freed-claims.js --require-clear
ExecStart=/opt/aubtown/symphony/8001b52e3062495a16e520e4ceaf8f9de868c4d0/symphony --i-understand-that-this-will-be-running-without-the-usual-guardrails --logs-root /var/lib/aubtown/logs/symphony --port 7080 /etc/aubtown/WORKFLOW.md
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
StateDirectory=aubtown/symphony aubtown/admission
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/aubtown
ReadWritePaths=/var/lib/aubtown/symphony /var/lib/aubtown/admission /var/lib/aubtown/logs/symphony /var/lib/freed/automation/control/.guards/tasks.lock/kernel.lock /var/lib/freed/automation/control/.guards/events.lock/kernel.lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
