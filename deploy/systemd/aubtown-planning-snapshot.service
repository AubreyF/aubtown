[Unit]
Description=FreedTown read-only planning snapshot collector
Requires=aubtown-github-token.service aubtown-host-gateway.service
After=aubtown-github-token.service aubtown-host-gateway.service

[Service]
Type=oneshot
User=aubtown-symphony
Group=aubtown-symphony
WorkingDirectory=/var/lib/aubtown/symphony
EnvironmentFile=/etc/aubtown/symphony.env
ExecStart=/opt/aubtown/node/bin/node /opt/aubtown/current/dist/cli/collect-planning-snapshot.js
StateDirectory=aubtown/coordinator
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/aubtown /srv/freed /var/lib/freed/automation
ReadWritePaths=/var/lib/aubtown/coordinator /var/lib/freed/automation/control/.guards/tasks.lock/kernel.lock /var/lib/freed/automation/control/.guards/events.lock/kernel.lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
SystemCallArchitectures=native
