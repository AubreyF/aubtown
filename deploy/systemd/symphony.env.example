PATH=/opt/aubtown/bin:/usr/local/bin:/usr/bin:/bin
HOME=/var/lib/aubtown/symphony
CODEX_HOME=/var/lib/aubtown/symphony/codex
AUBTOWN_SYMPHONY_WORKSPACES=/var/lib/aubtown/workspaces
AUBTOWN_SYMPHONY_SSH_CONFIG=/etc/aubtown/ssh/config
AUBTOWN_PRELAUNCH_CANDIDATE_ROOT=/var/lib/aubtown/admission/candidates
AUBTOWN_PRELAUNCH_ENVELOPE_ROOT=/var/lib/aubtown/admission/envelopes
AUBTOWN_PRELAUNCH_RECEIPT_ROOT=/var/lib/aubtown/admission/receipts
AUBTOWN_FREED_REPOSITORY_ROOT=/srv/freed
AUBTOWN_FREED_STATE_ROOT=/var/lib/freed/automation
AUBTOWN_FREED_NODE_EXECUTABLE=/opt/aubtown/node/bin/node
AUBTOWN_FREED_CLAIM_BROKER=/opt/freed/bin/factory-coordinator
AUBTOWN_HOST_OBSERVATION_JOURNAL_FILE=/var/lib/aubtown/coordinator/host-observations.json
AUBTOWN_HOST_ENROLLMENTS_FILE=/etc/aubtown/hosts.json
AUBTOWN_ACCOUNT_PROFILES_FILE=/etc/aubtown/account-profiles.json
AUBTOWN_HOST_WORKSPACE_ROOTS_FILE=/etc/aubtown/host-workspaces.json
AUBTOWN_PLANNING_SNAPSHOT_FILE=/var/lib/aubtown/coordinator/planning-snapshot.json
AUBTOWN_DISPATCH_INTENTION_FILE=/var/lib/aubtown/coordinator/dispatch-intention.json
AUBTOWN_PILOT_READINESS_FILE=/var/lib/aubtown/coordinator/pilot-readiness.json
AUBTOWN_RELEASE_ROOT=/opt/aubtown/releases/replace-with-revision
AUBTOWN_SYMPHONY_LOCK_FILE=/opt/aubtown/releases/replace-with-revision/upstream/symphony.lock.json
AUBTOWN_SYMPHONY_EXECUTABLE=/opt/aubtown/symphony/8001b52e3062495a16e520e4ceaf8f9de868c4d0/symphony
AUBTOWN_SYMPHONY_WORKFLOW_FILE=/etc/aubtown/WORKFLOW.md
AUBTOWN_GIT_EXECUTABLE=/usr/bin/git
AUBTOWN_PILOT_ISSUE_NUMBER=replace-with-owner-selected-issue-number
AUBTOWN_REPOSITORY_DEFAULT_BRANCH=dev
AUBTOWN_GITHUB_APP_PRIVATE_KEY_FILE=/etc/aubtown/keys/github-app-private.pem
AUBTOWN_GITHUB_INSTALLATION_ID=replace-with-installation-id
AUBTOWN_GITHUB_APP_ID=replace-with-app-id
GITHUB_REPO=freed-project/freed
GITHUB_TOKEN_FILE=/var/lib/aubtown/symphony/secrets/github.token
