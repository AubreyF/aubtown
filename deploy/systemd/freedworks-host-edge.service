[Unit]
Description=Freedworks signed host ingress edge
Requires=freedworks-restate.service
After=network-online.target freedworks-restate.service

[Service]
Type=simple
User=freedworks-edge
Group=freedworks-edge
WorkingDirectory=/opt/freedworks/current
ExecStart=/usr/bin/env PORT=8090 FREEDWORKS_BIND_HOST=127.0.0.1 FREEDWORKS_RESTATE_INGRESS=http://127.0.0.1:8080 /opt/freedworks/node/bin/node /opt/freedworks/current/dist/edge-gateway.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
