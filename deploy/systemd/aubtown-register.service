[Unit]
Description=Register the AubTown endpoint with Restate
Requires=aubtown-restate.service aubtown-control-plane.service
After=aubtown-restate.service aubtown-control-plane.service
PartOf=aubtown-control-plane.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=aubtown-control
Group=aubtown-control
Environment=CI=true
ExecStart=/opt/aubtown/restate/1.7.3/restate deployments register --force --yes http://127.0.0.1:9080
RemainAfterExit=true
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
