[Unit]
Description=FreedTown signed host observation gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=aubtown-symphony
Group=aubtown-symphony
WorkingDirectory=/opt/aubtown/current
EnvironmentFile=/etc/aubtown/host-gateway.env
ExecStart=/opt/aubtown/node/bin/node /opt/aubtown/current/dist/host-gateway.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=aubtown/coordinator
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/aubtown
ReadWritePaths=/var/lib/aubtown/coordinator
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
