[Unit]
Description=Freedworks signed host and quota agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=freedworks-executor
Group=freedworks-executor
WorkingDirectory=/opt/freedworks/current
EnvironmentFile=/etc/freedworks/host-agent.env
ExecStart=/opt/freedworks/node/bin/node /opt/freedworks/current/dist/host-agent.js
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/freedworks
UMask=0077

[Install]
WantedBy=multi-user.target
