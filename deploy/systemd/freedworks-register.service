[Unit]
Description=Register the Freedworks endpoint with Restate
Requires=freedworks-restate.service freedworks-control-plane.service
After=freedworks-restate.service freedworks-control-plane.service
PartOf=freedworks-control-plane.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=freedworks-control
Group=freedworks-control
Environment=CI=true
ExecStart=/opt/freedworks/restate/1.7.3/restate deployments register --force --yes http://127.0.0.1:9080
RemainAfterExit=true
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
