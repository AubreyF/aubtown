Match User aubtown-publisher
    AuthenticationMethods publickey
    AuthorizedKeysFile /etc/aubtown/ssh/publisher_authorized_keys
    ForceCommand /opt/aubtown/node/bin/node /opt/aubtown/releases/replace-with-revision/dist/cli/publisher-ssh-gateway.js /etc/aubtown/publisher-runtime.json /opt/aubtown/releases/replace-with-revision/dist/cli/publish-draft-local.js /etc/aubtown/ssh/publisher_authorized_keys
    DisableForwarding yes
    PermitTTY no
    X11Forwarding no
    PermitUserRC no
    PasswordAuthentication no
    KbdInteractiveAuthentication no
