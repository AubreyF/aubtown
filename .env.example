FREEDWORKS_HOST_ID=linux-control-1
FREEDWORKS_HOST_LANE=linux
FREEDWORKS_ACCOUNT_ID=codex-pro-1
FREEDWORKS_HOST_GATEWAY_URL=http://127.0.0.1:8090
FREEDWORKS_HOST_PRIVATE_KEY_FILE=/var/lib/freedworks/identity/host-private.pem
FREEDWORKS_HOST_SEQUENCE_FILE=/var/lib/freedworks/state/host-envelope.sequence
FREEDWORKS_QUOTA_SAMPLE_SECONDS=60
FREEDWORKS_CODEX_MODEL=replace_with_an_advertised_callable_model
FREEDWORKS_CODEX_EFFORT=high
FREEDWORKS_GIT_EXECUTABLE=/usr/bin/git
FREEDWORKS_RESTATE_PORT=9080
FREEDWORKS_RESTATE_IDENTITY_KEYS=publickeyv1_replace_me
FREEDWORKS_HOST_ENROLLMENTS_FILE=/etc/freedworks/host-enrollments.json
FREEDWORKS_ACCOUNT_PROFILES_FILE=/etc/freedworks/account-profiles.json
FREEDWORKS_CHECKPOINT_GRANT_PRIVATE_KEY_FILE=/etc/freedworks/checkpoint-grant-private.pem
FREEDWORKS_CHECKPOINT_GRANT_PUBLIC_KEY_FILE=/etc/freedworks/checkpoint-grant-public.pem
FREEDWORKS_CHECKPOINT_RECEIPT_PRIVATE_KEY_FILE=/etc/freedworks/checkpoint-receipt-private.pem
FREEDWORKS_CHECKPOINT_RECEIPT_PUBLIC_KEY_FILE=/etc/freedworks/checkpoint-receipt-public.pem
FREEDWORKS_CHECKPOINT_EDGE_URL=http://127.0.0.1:8091
FREEDWORKS_CHECKPOINT_LOCAL_STORE_ROOT=/var/lib/freedworks/checkpoints-local
FREEDWORKS_CHECKPOINT_KEY_FILE=/var/lib/freedworks/identity/checkpoint-key.bin
FREEDWORKS_CHECKPOINT_KEY_REFERENCE=pilot:checkpoint-v1
FREED_REPOSITORY_ROOT=/srv/freedworks/repositories/freed
FREEDWORKS_WORKTREE_ROOT=/srv/freedworks/worktrees/freed
FREEDWORKS_WORKTREE_HELPER=/srv/freedworks/repositories/freed/scripts/worktree-add.sh
FREED_AUTOMATION_STATE_ROOT=/srv/freedworks/state/freed/automation
CODEX_HOME=/srv/freedworks/credentials/codex-pro-1
