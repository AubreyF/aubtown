AUBTOWN_HOST_ID=linux-control-1
AUBTOWN_HOST_LANE=linux
AUBTOWN_ACCOUNT_ID=codex-pro-1
AUBTOWN_HOST_GATEWAY_URL=http://127.0.0.1:8090
AUBTOWN_HOST_PRIVATE_KEY_FILE=/var/lib/aubtown/identity/host-private.pem
AUBTOWN_HOST_SEQUENCE_FILE=/var/lib/aubtown/state/host-envelope.sequence
AUBTOWN_QUOTA_SAMPLE_SECONDS=60
AUBTOWN_CODEX_MODEL=replace_with_an_advertised_callable_model
AUBTOWN_CODEX_EFFORT=high
AUBTOWN_GIT_EXECUTABLE=/usr/bin/git
AUBTOWN_RESTATE_PORT=9080
AUBTOWN_RESTATE_IDENTITY_KEYS=publickeyv1_replace_me
AUBTOWN_HOST_ENROLLMENTS_FILE=/etc/aubtown/host-enrollments.json
AUBTOWN_ACCOUNT_PROFILES_FILE=/etc/aubtown/account-profiles.json
AUBTOWN_CHECKPOINT_GRANT_PRIVATE_KEY_FILE=/etc/aubtown/checkpoint-grant-private.pem
AUBTOWN_CHECKPOINT_GRANT_PUBLIC_KEY_FILE=/etc/aubtown/checkpoint-grant-public.pem
AUBTOWN_CHECKPOINT_RECEIPT_PRIVATE_KEY_FILE=/etc/aubtown/checkpoint-receipt-private.pem
AUBTOWN_CHECKPOINT_RECEIPT_PUBLIC_KEY_FILE=/etc/aubtown/checkpoint-receipt-public.pem
AUBTOWN_CHECKPOINT_EDGE_URL=http://127.0.0.1:8091
AUBTOWN_CHECKPOINT_LOCAL_STORE_ROOT=/var/lib/aubtown/checkpoints-local
AUBTOWN_CHECKPOINT_KEY_FILE=/var/lib/aubtown/identity/checkpoint-key.bin
AUBTOWN_CHECKPOINT_KEY_REFERENCE=pilot:checkpoint-v1
FREED_REPOSITORY_ROOT=/srv/aubtown/repositories/freed
AUBTOWN_WORKTREE_ROOT=/srv/aubtown/worktrees/freed
AUBTOWN_WORKTREE_HELPER=/srv/aubtown/repositories/freed/scripts/worktree-add.sh
FREED_AUTOMATION_STATE_ROOT=/srv/aubtown/state/freed/automation
CODEX_HOME=/srv/aubtown/credentials/codex-pro-1
