+defmodule SymphonyElixir.Admission do
+  @moduledoc """
+  Runs an optional final host-side admission command immediately before worker launch.
+
+  The command receives only stable issue and selected-host identifiers. It must emit one JSON
+  decision. Missing, malformed, mismatched, failed, or timed-out decisions fail closed.
+  """
+
+  alias SymphonyElixir.Config
+  alias SymphonyElixir.Tracker.Issue
+
+  @max_output_bytes 65_536
+  @reason_pattern ~r/^[a-z0-9][a-z0-9._:-]{0,127}$/
+  @receipt_pattern ~r/^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$/
+
+  @type worker_host :: String.t() | nil
+  @type decision :: {:admit, String.t()} | {:deny, String.t()} | {:error, term()}
+
+  @spec check(Issue.t(), worker_host()) :: decision()
+  def check(%Issue{id: issue_id, identifier: identifier}, worker_host)
+      when is_binary(issue_id) and is_binary(identifier) do
+    settings = Config.settings!()
+
+    case settings.admission.command do
+      [] ->
+        {:admit, "admission-disabled"}
+
+      [executable | configured_args] ->
+        host = worker_host || "local"
+
+        args =
+          configured_args ++
+            [
+              "--schema-version",
+              "1",
+              "--issue-id",
+              issue_id,
+              "--issue-identifier",
+              identifier,
+              "--worker-host",
+              host
+            ]
+
+        run(executable, args, issue_id, host, settings.admission.timeout_ms)
+    end
+  end
+
+  def check(_issue, _worker_host), do: {:error, :invalid_admission_issue}
+
+  defp run(executable, args, issue_id, worker_host, timeout_ms) do
+    task =
+      Task.async(fn ->
+        try do
+          {:ok,
+           System.cmd(executable, args,
+             env: secret_environment_scrub(),
+             stderr_to_stdout: true
+           )}
+        rescue
+          error in [ArgumentError, ErlangError] ->
+            {:error, {:admission_command_start_failed, Exception.message(error)}}
+        end
+      end)
+
+    case Task.yield(task, timeout_ms) do
+      {:ok, {:ok, {output, 0}}} ->
+        parse(output, issue_id, worker_host)
+
+      {:ok, {:ok, {output, status}}} ->
+        {:error, {:admission_command_failed, status, bounded_output(output)}}
+
+      {:ok, {:error, reason}} ->
+        {:error, reason}
+
+      {:exit, reason} ->
+        {:error, {:admission_command_crashed, reason}}
+
+      nil ->
+        Task.shutdown(task, :brutal_kill)
+        {:error, {:admission_command_timeout, timeout_ms}}
+    end
+  end
+
+  defp parse(output, issue_id, worker_host) when is_binary(output) do
+    with true <- byte_size(output) <= @max_output_bytes or {:error, :admission_output_too_large},
+         {:ok, payload} <- Jason.decode(String.trim(output)),
+         true <- is_map(payload) or {:error, :invalid_admission_response},
+         1 <- payload["schemaVersion"],
+         ^issue_id <- payload["issueId"],
+         ^worker_host <- payload["workerHost"] do
+      parse_decision(payload)
+    else
+      {:error, reason} -> {:error, reason}
+      _ -> {:error, :admission_response_mismatch}
+    end
+  end
+
+  defp parse(_output, _issue_id, _worker_host), do: {:error, :invalid_admission_response}
+
+  defp parse_decision(%{"decision" => "admit", "receiptId" => receipt_id})
+       when is_binary(receipt_id) do
+    if Regex.match?(@receipt_pattern, receipt_id) do
+      {:admit, receipt_id}
+    else
+      {:error, :invalid_admission_receipt}
+    end
+  end
+
+  defp parse_decision(%{"decision" => "deny", "reason" => reason}) when is_binary(reason) do
+    if Regex.match?(@reason_pattern, reason) do
+      {:deny, reason}
+    else
+      {:error, :invalid_admission_reason}
+    end
+  end
+
+  defp parse_decision(_payload), do: {:error, :invalid_admission_decision}
+
+  defp secret_environment_scrub do
+    Config.settings!().tracker.secret_environment_names
+    |> Kernel.++([
+      "AUBTOWN_GITHUB_APP_PRIVATE_KEY_FILE",
+      "GITHUB_TOKEN",
+      "GITHUB_TOKEN_FILE",
+      "GH_TOKEN",
+      "GITHUB_ENTERPRISE_TOKEN",
+      "GH_ENTERPRISE_TOKEN"
+    ])
+    |> Enum.uniq()
+    |> Enum.map(&{&1, nil})
+  end
+
+  defp bounded_output(output) when is_binary(output) and byte_size(output) <= @max_output_bytes,
+    do: output
+
+  defp bounded_output(output) when is_binary(output),
+    do: binary_part(output, 0, @max_output_bytes)
+
+  defp bounded_output(_output), do: ""
+end
