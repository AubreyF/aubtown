diff --git a/elixir/test/symphony_elixir/admission_test.exs b/elixir/test/symphony_elixir/admission_test.exs
new file mode 100644
index 0000000000000000000000000000000000000000..fe321c68a11857ad26560405c82474bb0948d1fb
--- /dev/null
+++ b/elixir/test/symphony_elixir/admission_test.exs
@@ -0,0 +1,155 @@
+defmodule SymphonyElixir.AdmissionTest do
+  use SymphonyElixir.TestSupport
+
+  alias SymphonyElixir.Admission
+  alias SymphonyElixir.Tracker.Issue
+
+  setup do
+    root = Path.join(System.tmp_dir!(), "symphony-admission-#{System.unique_integer([:positive])}")
+    File.mkdir_p!(root)
+    on_exit(fn -> File.rm_rf(root) end)
+    %{root: root}
+  end
+
+  test "admits only a matching decision from an absolute no-shell command", %{root: root} do
+    prior_token = System.get_env("GITHUB_TOKEN")
+    prior_token_file = System.get_env("GITHUB_TOKEN_FILE")
+    prior_private_key = System.get_env("AUBTOWN_GITHUB_APP_PRIVATE_KEY_FILE")
+
+    on_exit(fn ->
+      restore_secret_env("GITHUB_TOKEN", prior_token)
+      restore_secret_env("GITHUB_TOKEN_FILE", prior_token_file)
+      restore_secret_env("AUBTOWN_GITHUB_APP_PRIVATE_KEY_FILE", prior_private_key)
+    end)
+
+    System.put_env("GITHUB_TOKEN", "must-not-leak")
+    System.put_env("GITHUB_TOKEN_FILE", "/must/not/leak")
+    System.put_env("AUBTOWN_GITHUB_APP_PRIVATE_KEY_FILE", "/must/not/leak")
+
+    script =
+      write_script!(root, "admit", """
+      #!/bin/sh
+      if [ -n "${GITHUB_TOKEN:-}" ] || [ -n "${GITHUB_TOKEN_FILE:-}" ] || [ -n "${AUBTOWN_GITHUB_APP_PRIVATE_KEY_FILE:-}" ]; then
+        exit 9
+      fi
+      issue_id=''
+      worker_host=''
+      while [ "$#" -gt 0 ]; do
+        case "$1" in
+          --issue-id) issue_id="$2"; shift 2 ;;
+          --worker-host) worker_host="$2"; shift 2 ;;
+          *) shift ;;
+        esac
+      done
+      printf '{"schemaVersion":1,"decision":"admit","issueId":"%s","workerHost":"%s","receiptId":"receipt-123"}\n' "$issue_id" "$worker_host"
+      """)
+
+    write_workflow_file!(Workflow.workflow_file_path(),
+      tracker_kind: "memory",
+      admission_command: [script]
+    )
+
+    assert Admission.check(issue(), "worker-linux") == {:admit, "receipt-123"}
+  end
+
+  test "returns a bounded denial without launching a worker", %{root: root} do
+    script =
+      write_script!(root, "deny", """
+      #!/bin/sh
+      issue_id=''
+      worker_host=''
+      while [ "$#" -gt 0 ]; do
+        case "$1" in
+          --issue-id) issue_id="$2"; shift 2 ;;
+          --worker-host) worker_host="$2"; shift 2 ;;
+          *) shift ;;
+        esac
+      done
+      printf '{"schemaVersion":1,"decision":"deny","issueId":"%s","workerHost":"%s","reason":"quota-blocked"}\n' "$issue_id" "$worker_host"
+      """)
+
+    write_workflow_file!(Workflow.workflow_file_path(),
+      tracker_kind: "memory",
+      admission_command: [script]
+    )
+
+    assert Admission.check(issue(), "worker-linux") == {:deny, "quota-blocked"}
+  end
+
+  test "fails closed on mismatched, malformed, or failed responses", %{root: root} do
+    mismatch =
+      write_script!(root, "mismatch", """
+      #!/bin/sh
+      printf '{"schemaVersion":1,"decision":"admit","issueId":"other","workerHost":"worker-linux","receiptId":"receipt-123"}\n'
+      """)
+
+    malformed =
+      write_script!(root, "malformed", """
+      #!/bin/sh
+      printf 'not json\n'
+      """)
+
+    failed =
+      write_script!(root, "failed", """
+      #!/bin/sh
+      printf 'nope\n'
+      exit 7
+      """)
+
+    for {script, expected} <- [
+          {mismatch, :admission_response_mismatch},
+          {malformed, %Jason.DecodeError{}},
+          {failed, {:admission_command_failed, 7, "nope\n"}}
+        ] do
+      write_workflow_file!(Workflow.workflow_file_path(),
+        tracker_kind: "memory",
+        admission_command: [script]
+      )
+
+      case {Admission.check(issue(), "worker-linux"), expected} do
+        {{:error, %Jason.DecodeError{}}, %Jason.DecodeError{}} -> :ok
+        {{:error, actual}, expected} -> assert actual == expected
+      end
+    end
+  end
+
+  test "keeps upstream dispatch behavior when admission is unconfigured" do
+    write_workflow_file!(Workflow.workflow_file_path(),
+      tracker_kind: "memory",
+      admission_command: []
+    )
+
+    assert Admission.check(issue(), nil) == {:admit, "admission-disabled"}
+  end
+
+  test "rejects relative executables and excessive timeouts" do
+    write_workflow_file!(Workflow.workflow_file_path(), admission_command: ["relative-command"])
+    assert {:error, {:invalid_workflow_config, message}} = Config.validate!()
+    assert message =~ "executable must use an absolute path"
+
+    write_workflow_file!(Workflow.workflow_file_path(), admission_timeout_ms: 60_001)
+    assert {:error, {:invalid_workflow_config, message}} = Config.validate!()
+    assert message =~ "admission.timeout_ms"
+  end
+
+  defp issue do
+    %Issue{
+      id: "issue-123",
+      identifier: "GH-123",
+      title: "Guard launch",
+      state: "open",
+      labels: ["factory:running"],
+      dispatchable: true
+    }
+  end
+
+  defp write_script!(root, name, content) do
+    path = Path.join(root, name)
+    File.write!(path, content)
+    File.chmod!(path, 0o700)
+    path
+  end
+
+  defp restore_secret_env(name, nil), do: System.delete_env(name)
+  defp restore_secret_env(name, value), do: System.put_env(name, value)
+end
