+  test "prelaunch denial prevents the worker process and workspace from starting" do
+    issue_suffix = System.unique_integer([:positive])
+
+    test_root =
+      Path.join(
+        System.tmp_dir!(),
+        "symphony-elixir-prelaunch-denial-#{issue_suffix}"
+      )
+
+    admission_marker = Path.join(test_root, "admission-checked")
+    admission_script = Path.join(test_root, "deny-admission")
+    runtime_supervisor_name = Module.concat(__MODULE__, "AdmissionRuntime#{issue_suffix}")
+    task_supervisor_name = Module.concat(__MODULE__, "AdmissionTasks#{issue_suffix}")
+    orchestrator_name = Module.concat(__MODULE__, "AdmissionOrchestrator#{issue_suffix}")
+    previous_memory_issues = Application.get_env(:symphony_elixir, :memory_tracker_issues)
+
+    issue = %Issue{
+      id: "issue-admission-#{issue_suffix}",
+      identifier: "MT-#{issue_suffix}",
+      title: "Deny a worker at prelaunch",
+      description: "No process or workspace may start",
+      state: "In Progress",
+      url: "https://example.org/issues/MT-#{issue_suffix}",
+      labels: [],
+      dispatchable: true
+    }
+
+    on_exit(fn ->
+      if pid = Process.whereis(runtime_supervisor_name) do
+        GenServer.stop(pid)
+      end
+
+      restore_app_env(:memory_tracker_issues, previous_memory_issues)
+      restart_default_runtime!()
+      File.rm_rf(test_root)
+    end)
+
+    if Process.whereis(SymphonyElixir.AgentRuntimeSupervisor) do
+      assert :ok =
+               Supervisor.terminate_child(
+                 SymphonyElixir.Supervisor,
+                 SymphonyElixir.AgentRuntimeSupervisor
+               )
+    end
+
+    File.mkdir_p!(test_root)
+
+    File.write!(
+      admission_script,
+      """
+      #!/bin/sh
+      issue_id=''
+      worker_host=''
+      while [ "$#" -gt 0 ]; do
+        case "$1" in
+          --issue-id) issue_id="$2"; shift 2 ;;
+          --worker-host) worker_host="$2"; shift 2 ;;
+          *) shift ;;
+        esac
+      done
+      : > "#{admission_marker}"
+      printf '{"schemaVersion":1,"decision":"deny","issueId":"%s","workerHost":"%s","reason":"authority-blocked"}\n' "$issue_id" "$worker_host"
+      """
+    )
+
+    File.chmod!(admission_script, 0o700)
+
+    write_workflow_file!(Workflow.workflow_file_path(),
+      tracker_kind: "memory",
+      workspace_root: Path.join(test_root, "workspaces"),
+      poll_interval_ms: 10,
+      admission_command: [admission_script]
+    )
+
+    Application.put_env(:symphony_elixir, :memory_tracker_issues, [issue])
+
+    assert {:ok, runtime_supervisor_pid} =
+             SymphonyElixir.AgentRuntimeSupervisor.start_link(
+               name: runtime_supervisor_name,
+               task_supervisor_name: task_supervisor_name,
+               orchestrator_name: orchestrator_name
+             )
+
+    Process.unlink(runtime_supervisor_pid)
+
+    assert eventually_value(fn -> if File.exists?(admission_marker), do: true end)
+    assert Task.Supervisor.children(task_supervisor_name) == []
+    refute File.exists?(Path.join([test_root, "workspaces", Workspace.workspace_key(issue)]))
+  end
+
