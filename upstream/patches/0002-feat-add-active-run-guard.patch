@@ -219,6 +219,44 @@ defmodule SymphonyElixir.Config.Schema do
     end
   end
 
+  defmodule ActiveGuard do
+    @moduledoc false
+    use Ecto.Schema
+    import Ecto.Changeset
+
+    @primary_key false
+    embedded_schema do
+      field(:command, {:array, :string}, default: [])
+      field(:interval_ms, :integer, default: 30_000)
+      field(:timeout_ms, :integer, default: 5_000)
+      field(:interrupt_grace_ms, :integer, default: 5_000)
+    end
+
+    @spec changeset(%__MODULE__{}, map()) :: Ecto.Changeset.t()
+    def changeset(schema, attrs) do
+      schema
+      |> cast(attrs, [:command, :interval_ms, :timeout_ms, :interrupt_grace_ms], empty_values: [])
+      |> validate_number(:interval_ms, greater_than: 0, less_than_or_equal_to: 60_000)
+      |> validate_number(:timeout_ms, greater_than: 0, less_than_or_equal_to: 900_000)
+      |> validate_number(:interrupt_grace_ms, greater_than: 0, less_than_or_equal_to: 60_000)
+      |> validate_change(:command, fn :command, command ->
+        cond do
+          command == [] ->
+            []
+
+          not Enum.all?(command, &(is_binary(&1) and String.trim(&1) != "")) ->
+            [command: "must contain only nonblank arguments"]
+
+          Path.type(List.first(command)) != :absolute ->
+            [command: "executable must use an absolute path"]
+
+          true ->
+            []
+        end
+      end)
+    end
+  end
+
