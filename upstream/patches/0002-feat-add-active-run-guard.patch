+  defp handle_active_guard_interrupt(
+         port,
+         on_message,
+         timeout_ms,
+         pending_line,
+         tool_executor,
+         auto_approve_requests,
+         guard_state,
+         thread_id,
+         turn_id,
+         ref,
+         reason
+       ) do
+    case guard_state do
+      %{handle: %{ref: ^ref}, interrupt_reason: nil} = active_state ->
+        send_message(port, %{
+          "method" => "turn/interrupt",
+          "id" => "aubtown-active-guard-#{System.unique_integer([:positive])}",
+          "params" => %{"threadId" => thread_id, "turnId" => turn_id}
+        })
+
+        receive_loop(
+          port,
+          on_message,
+          timeout_ms,
+          pending_line,
+          tool_executor,
+          auto_approve_requests,
+          %{active_state | interrupt_reason: reason},
+          thread_id,
+          turn_id
+        )
+
+      _ ->
+        receive_loop(
+          port,
+          on_message,
+          timeout_ms,
+          pending_line,
+          tool_executor,
+          auto_approve_requests,
+          guard_state,
+          thread_id,
+          turn_id
+        )
+    end
+  end
