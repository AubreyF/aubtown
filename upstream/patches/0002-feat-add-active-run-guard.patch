diff --git a/elixir/test/symphony_elixir/active_guard_test.exs b/elixir/test/symphony_elixir/active_guard_test.exs
new file mode 100644
index 0000000..eaee3a6
--- /dev/null
+++ b/elixir/test/symphony_elixir/active_guard_test.exs
@@ -0,0 +1,123 @@
+defmodule SymphonyElixir.ActiveGuardTest do
+  use SymphonyElixir.TestSupport
+
+  alias SymphonyElixir.ActiveGuard
+  alias SymphonyElixir.Tracker.Issue
+
+  setup do
+    root = Path.join(System.tmp_dir!(), "symphony-active-guard-#{System.unique_integer([:positive])}")
+    File.mkdir_p!(root)
+    on_exit(fn -> File.rm_rf(root) end)
+    %{root: root}
+  end
+
+  test "continues after an exact continue response", %{root: root} do
+    script = decision_script!(root, "continue", "quota-headroom-available")
+
+    write_workflow_file!(Workflow.workflow_file_path(),
+      tracker_kind: "memory",
+      active_guard_command: [script],
+      active_guard_interval_ms: 10,
+      active_guard_timeout_ms: 500
+    )
+
+    assert {:ok, handle} =
+             ActiveGuard.start(issue(), "worker-linux", "thread-123", "turn-123", self())
+
+    refute_receive {:active_guard_interrupt, _, _}, 50
+    assert :ok = ActiveGuard.stop(handle)
+  end
+
+  test "requests a bound interrupt and then a hard stop", %{root: root} do
+    script = decision_script!(root, "interrupt", "quota-weekly-ceiling")
+
+    write_workflow_file!(Workflow.workflow_file_path(),
+      tracker_kind: "memory",
+      active_guard_command: [script],
+      active_guard_interval_ms: 10,
+      active_guard_timeout_ms: 500,
+      active_guard_interrupt_grace_ms: 20
+    )
+
+    assert {:ok, handle} =
+             ActiveGuard.start(issue(), "worker-linux", "thread-123", "turn-123", self())
+
+    assert_receive {:active_guard_interrupt, ref, "quota-weekly-ceiling"}, 500
+    assert ref == handle.ref
+    assert_receive {:active_guard_hard_stop, ^ref, "quota-weekly-ceiling"}, 500
+    assert :ok = ActiveGuard.stop(handle)
+  end
+
+  test "fails closed on malformed or failed checks", %{root: root} do
+    malformed = write_script!(root, "malformed", "#!/bin/sh\nprintf 'nope\\n'\n")
+
+    write_workflow_file!(Workflow.workflow_file_path(),
+      tracker_kind: "memory",
+      active_guard_command: [malformed],
+      active_guard_interval_ms: 10,
+      active_guard_timeout_ms: 500
+    )
+
+    assert {:ok, handle} =
+             ActiveGuard.start(issue(), "worker-linux", "thread-123", "turn-123", self())
+
+    assert_receive {:active_guard_interrupt, ref, "active-guard-response-invalid"}, 500
+    assert ref == handle.ref
+    assert :ok = ActiveGuard.stop(handle)
+  end
+
+  test "keeps upstream behavior when unconfigured and validates configuration" do
+    assert :disabled = ActiveGuard.start(issue(), nil, "thread-123", "turn-123", self())
+
+    write_workflow_file!(Workflow.workflow_file_path(), active_guard_command: ["relative"])
+    assert {:error, {:invalid_workflow_config, message}} = Config.validate!()
+    assert message =~ "active_guard.command"
+
+    write_workflow_file!(Workflow.workflow_file_path(), active_guard_interval_ms: 60_001)
+    assert {:error, {:invalid_workflow_config, message}} = Config.validate!()
+    assert message =~ "active_guard.interval_ms"
+
+    write_workflow_file!(Workflow.workflow_file_path(), active_guard_timeout_ms: 900_001)
+    assert {:error, {:invalid_workflow_config, message}} = Config.validate!()
+    assert message =~ "active_guard.timeout_ms"
+  end
+
+  defp decision_script!(root, decision, reason) do
+    write_script!(root, decision, """
+    #!/bin/sh
+    issue_id=''
+    worker_host=''
+    thread_id=''
+    turn_id=''
+    while [ "$#" -gt 0 ]; do
+      case "$1" in
+        --issue-id) issue_id="$2"; shift 2 ;;
+        --worker-host) worker_host="$2"; shift 2 ;;
+        --thread-id) thread_id="$2"; shift 2 ;;
+        --turn-id) turn_id="$2"; shift 2 ;;
+        *) shift ;;
+      esac
+    done
+    printf '{"schemaVersion":1,"decision":"#{decision}","issueId":"%s","workerHost":"%s","threadId":"%s","turnId":"%s","reason":"#{reason}"}\n' "$issue_id" "$worker_host" "$thread_id" "$turn_id"
+    """)
+  end
+
+  defp issue do
+    %Issue{
+      id: "123",
+      identifier: "GH-123",
+      title: "Guard active turn",
+      state: "open",
+      labels: ["factory:running"],
+      dispatchable: true
+    }
+  end
+
+  defp write_script!(root, name, content) do
+    path = Path.join(root, name)
+    File.write!(path, content)
+    File.chmod!(path, 0o700)
+    path
+  end
+end
diff --git a/elixir/test/symphony_elixir/app_server_test.exs b/elixir/test/symphony_elixir/app_server_test.exs
index 4b23aed..1455482 100644
--- a/elixir/test/symphony_elixir/app_server_test.exs
+++ b/elixir/test/symphony_elixir/app_server_test.exs
@@ -1628,4 +1628,102 @@ defmodule SymphonyElixir.AppServerTest do
       File.rm_rf(test_root)
     end
   end
+
+  test "active guard interrupts the exact running thread and turn" do
+    test_root =
+      Path.join(
+        System.tmp_dir!(),
+        "symphony-elixir-app-server-active-guard-#{System.unique_integer([:positive])}"
+      )
+
+    try do
+      workspace_root = Path.join(test_root, "workspaces")
+      workspace = Path.join(workspace_root, "GH-123")
+      codex_binary = Path.join(test_root, "fake-codex")
+      guard_binary = Path.join(test_root, "active-guard")
+      trace_file = Path.join(test_root, "codex.trace")
+      prior_trace = System.get_env("SYMP_TEST_CODEx_TRACE")
+
+      on_exit(fn -> restore_env("SYMP_TEST_CODEx_TRACE", prior_trace) end)
+      System.put_env("SYMP_TEST_CODEx_TRACE", trace_file)
+      File.mkdir_p!(workspace)
+
+      File.write!(codex_binary, """
+      #!/bin/sh
+      count=0
+      while IFS= read -r line; do
+        count=$((count + 1))
+        printf 'JSON:%s\n' "$line" >> "$SYMP_TEST_CODEx_TRACE"
+        case "$count" in
+          1) printf '%s\n' '{"id":1,"result":{}}' ;;
+          2) ;;
+          3) printf '%s\n' '{"id":2,"result":{"thread":{"id":"thread-123"}}}' ;;
+          4) printf '%s\n' '{"id":3,"result":{"turn":{"id":"turn-123"}}}' ;;
+          5) printf '%s\n' '{"method":"turn/cancelled","params":{"reason":"interrupted"}}'; exit 0 ;;
+        esac
+      done
+      """)
+
+      File.write!(guard_binary, """
+      #!/bin/sh
+      issue_id=''
+      worker_host=''
+      thread_id=''
+      turn_id=''
+      while [ "$#" -gt 0 ]; do
+        case "$1" in
+          --issue-id) issue_id="$2"; shift 2 ;;
+          --worker-host) worker_host="$2"; shift 2 ;;
+          --thread-id) thread_id="$2"; shift 2 ;;
+          --turn-id) turn_id="$2"; shift 2 ;;
+          *) shift ;;
+        esac
+      done
+      printf '{"schemaVersion":1,"decision":"interrupt","issueId":"%s","workerHost":"%s","threadId":"%s","turnId":"%s","reason":"quota-weekly-ceiling"}\n' "$issue_id" "$worker_host" "$thread_id" "$turn_id"
+      """)
+
+      File.chmod!(codex_binary, 0o755)
+      File.chmod!(guard_binary, 0o755)
+
+      write_workflow_file!(Workflow.workflow_file_path(),
+        tracker_kind: "memory",
+        workspace_root: workspace_root,
+        codex_command: "#{codex_binary} app-server",
+        active_guard_command: [guard_binary],
+        active_guard_interval_ms: 10,
+        active_guard_timeout_ms: 500,
+        active_guard_interrupt_grace_ms: 500
+      )
+
+      issue = %Issue{
+        id: "123",
+        identifier: "GH-123",
+        title: "Interrupt guarded run",
+        description: "Validate active quota interruption",
+        state: "open",
+        url: "https://example.org/issues/123",
+        labels: ["factory:running"]
+      }
+
+      assert {:error, {:active_guard_interrupt, "quota-weekly-ceiling"}} =
+               AppServer.run(workspace, "Guard this turn", issue)
+
+      assert trace_file
+             |> File.read!()
+             |> String.split("\n", trim: true)
+             |> Enum.any?(fn line ->
+               if String.starts_with?(line, "JSON:") do
+                 payload = line |> String.trim_leading("JSON:") |> Jason.decode!()
+
+                 payload["method"] == "turn/interrupt" &&
+                   get_in(payload, ["params", "threadId"]) == "thread-123" &&
+                   get_in(payload, ["params", "turnId"]) == "turn-123"
+               else
+                 false
+               end
+             end)
+    after
+      File.rm_rf(test_root)
+    end
+  end
 end
