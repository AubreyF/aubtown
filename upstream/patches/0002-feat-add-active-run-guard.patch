+++ b/elixir/lib/symphony_elixir/active_guard.ex
@@ -0,0 +1,219 @@
+defmodule SymphonyElixir.ActiveGuard do
+  @moduledoc """
+  Rechecks host-side policy while one Codex turn is active.
+
+  The command receives the exact issue, selected host, thread, and turn identities. A malformed,
+  mismatched, failed, timed-out, or crashed check requests interruption. The app-server owner sends
+  the protocol interrupt and closes the transport if the turn ignores the configured grace period.
+  """
+
+  alias SymphonyElixir.Config
+  alias SymphonyElixir.Tracker.Issue
+
+  @max_output_bytes 65_536
+  @reason_pattern ~r/^[a-z0-9][a-z0-9._:-]{0,127}$/
+
+  @type handle :: %{pid: pid(), monitor: reference(), ref: reference()}
+
+  @spec start(Issue.t(), String.t() | nil, String.t(), String.t(), pid()) ::
+          {:ok, handle()} | :disabled | {:error, term()}
+  def start(issue, worker_host, thread_id, turn_id, recipient) do
+    case Config.settings!().active_guard.command do
+      [] -> :disabled
+      command -> start_enabled(issue, worker_host, thread_id, turn_id, recipient, command)
+    end
+  end
+
+  defp start_enabled(
+         %Issue{id: issue_id, identifier: identifier},
+         worker_host,
+         thread_id,
+         turn_id,
+         recipient,
+         [executable | configured_args]
+       )
+       when is_binary(issue_id) and is_binary(identifier) and is_binary(thread_id) and
+              is_binary(turn_id) and is_pid(recipient) do
+    settings = Config.settings!()
+    host = worker_host || "local"
+    ref = make_ref()
+
+    pid =
+      spawn(fn ->
+        loop(%{
+          recipient: recipient,
+          ref: ref,
+          executable: executable,
+          args:
+            configured_args ++
+              [
+                "--schema-version",
+                "1",
+                "--issue-id",
+                issue_id,
+                "--issue-identifier",
+                identifier,
+                "--worker-host",
+                host,
+                "--thread-id",
+                thread_id,
+                "--turn-id",
+                turn_id
+              ],
+          issue_id: issue_id,
+          worker_host: host,
+          thread_id: thread_id,
+          turn_id: turn_id,
+          interval_ms: settings.active_guard.interval_ms,
+          timeout_ms: settings.active_guard.timeout_ms,
+          interrupt_grace_ms: settings.active_guard.interrupt_grace_ms
+        })
+      end)
+
+    {:ok, %{pid: pid, monitor: Process.monitor(pid), ref: ref}}
+  end
+
+  defp start_enabled(_issue, _worker_host, _thread_id, _turn_id, _recipient, _command),
+    do: {:error, :invalid_active_guard_binding}
+
+  @spec stop(handle() | :disabled) :: :ok
+  def stop(:disabled), do: :ok
+
+  def stop(%{pid: pid, monitor: monitor}) when is_pid(pid) and is_reference(monitor) do
+    send(pid, :stop)
+    Process.demonitor(monitor, [:flush])
+    :ok
+  end
+
+  defp loop(state) do
+    receive do
+      :stop ->
+        :ok
+    after
+      state.interval_ms ->
+        case run_check(state) do
+          {:continue, _reason} ->
+            loop(state)
+
+          {:interrupt, reason} ->
+            interrupt_and_wait(state, reason)
+
+          {:error, reason} ->
+            interrupt_and_wait(state, normalize_error(reason))
+        end
+    end
+  end
+
+  defp interrupt_and_wait(state, reason) do
+    send(state.recipient, {:active_guard_interrupt, state.ref, reason})
+
+    receive do
+      :stop ->
+        :ok
+    after
+      state.interrupt_grace_ms ->
+        send(state.recipient, {:active_guard_hard_stop, state.ref, reason})
+    end
+  end
+
+  defp run_check(state) do
+    task =
+      Task.async(fn ->
+        try do
+          {:ok,
+           System.cmd(state.executable, state.args,
+             env: secret_environment_scrub(),
+             stderr_to_stdout: true
+           )}
+        rescue
+          error in [ArgumentError, ErlangError] ->
+            {:error, {:active_guard_command_start_failed, Exception.message(error)}}
+        end
+      end)
+
+    case Task.yield(task, state.timeout_ms) do
+      {:ok, {:ok, {output, 0}}} ->
+        parse(output, state)
+
+      {:ok, {:ok, {output, status}}} ->
+        {:error, {:active_guard_command_failed, status, bounded_output(output)}}
+
+      {:ok, {:error, reason}} ->
+        {:error, reason}
+
+      {:exit, reason} ->
+        {:error, {:active_guard_command_crashed, reason}}
+
+      nil ->
+        Task.shutdown(task, :brutal_kill)
+        {:error, {:active_guard_command_timeout, state.timeout_ms}}
+    end
+  end
+
+  defp parse(output, state) when is_binary(output) do
+    issue_id = state.issue_id
+    worker_host = state.worker_host
+    thread_id = state.thread_id
+    turn_id = state.turn_id
+
+    with true <- byte_size(output) <= @max_output_bytes or {:error, :active_guard_output_too_large},
+         {:ok, payload} <- Jason.decode(String.trim(output)),
+         true <- is_map(payload) or {:error, :invalid_active_guard_response},
+         1 <- payload["schemaVersion"],
+         ^issue_id <- payload["issueId"],
+         ^worker_host <- payload["workerHost"],
+         ^thread_id <- payload["threadId"],
+         ^turn_id <- payload["turnId"],
+         reason when is_binary(reason) <- payload["reason"],
+         true <- Regex.match?(@reason_pattern, reason) or {:error, :invalid_active_guard_reason} do
+      case payload["decision"] do
+        "continue" -> {:continue, reason}
+        "interrupt" -> {:interrupt, reason}
+        _ -> {:error, :invalid_active_guard_decision}
+      end
+    else
+      {:error, reason} -> {:error, reason}
+      _ -> {:error, :active_guard_response_mismatch}
+    end
+  end
+
+  defp parse(_output, _state), do: {:error, :invalid_active_guard_response}
+
+  defp normalize_error(reason) do
+    case reason do
+      %Jason.DecodeError{} -> "active-guard-response-invalid"
+      :active_guard_output_too_large -> "active-guard-output-too-large"
+      :invalid_active_guard_response -> "active-guard-response-invalid"
+      :invalid_active_guard_reason -> "active-guard-reason-invalid"
+      :invalid_active_guard_decision -> "active-guard-decision-invalid"
+      :active_guard_response_mismatch -> "active-guard-response-mismatch"
+      {:active_guard_command_timeout, _timeout} -> "active-guard-command-timeout"
+      {:active_guard_command_failed, _status, _output} -> "active-guard-command-failed"
+      {:active_guard_command_start_failed, _message} -> "active-guard-command-start-failed"
+      {:active_guard_command_crashed, _reason} -> "active-guard-command-crashed"
+      _ -> "active-guard-failed"
+    end
+  end
+
+  defp secret_environment_scrub do
+    Config.settings!().tracker.secret_environment_names
+    |> Kernel.++([
+      "AUBTOWN_GITHUB_APP_PRIVATE_KEY_FILE",
+      "GITHUB_TOKEN",
+      "GITHUB_TOKEN_FILE",
+      "GH_TOKEN",
+      "GITHUB_ENTERPRISE_TOKEN",
+      "GH_ENTERPRISE_TOKEN"
+    ])
+    |> Enum.uniq()
+    |> Enum.map(&{&1, nil})
+  end
+
+  defp bounded_output(output) when is_binary(output) and byte_size(output) <= @max_output_bytes,
+    do: output
+
+  defp bounded_output(output) when is_binary(output),
+    do: binary_part(output, 0, @max_output_bytes)
+
+  defp bounded_output(_output), do: ""
+end
