diff --git a/elixir/test/symphony_elixir/workspace_and_config_test.exs b/elixir/test/symphony_elixir/workspace_and_config_test.exs
index 15f7c36..caaca85 100644
--- a/elixir/test/symphony_elixir/workspace_and_config_test.exs
+++ b/elixir/test/symphony_elixir/workspace_and_config_test.exs
@@ -925,6 +925,33 @@ defmodule SymphonyElixir.WorkspaceAndConfigTest do
     end
   end
 
+  test "trusted completion hook propagates failure" do
+    test_root =
+      Path.join(
+        System.tmp_dir!(),
+        "symphony-elixir-completion-hook-fail-#{System.unique_integer([:positive])}"
+      )
+
+    try do
+      workspace_root = Path.join(test_root, "workspaces")
+      File.mkdir_p!(workspace_root)
+
+      write_workflow_file!(Workflow.workflow_file_path(),
+        workspace_root: workspace_root,
+        hook_completion: "echo completion-denied && exit 17"
+      )
+
+      assert {:ok, workspace} = Workspace.create_for_issue("MT-COMPLETION-FAIL")
+
+      assert {:error, {:workspace_hook_failed, "completion", 17, output}} =
+               Workspace.run_completion_hook(workspace, "MT-COMPLETION-FAIL")
+
+      assert output =~ "completion-denied"
+    after
+      File.rm_rf(test_root)
+    end
+  end
+
   test "workspace remove continues when before_remove hook fails with large output" do
     test_root =
       Path.join(
