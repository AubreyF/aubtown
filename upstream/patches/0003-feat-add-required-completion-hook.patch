 elixir/lib/symphony_elixir/config/schema.ex   |  3 ++-
 elixir/lib/symphony_elixir/workspace.ex       | 22 +++++++++++++++
 elixir/test/support/test_support.exs          | 26 +++++++++++++++---
 elixir/test/symphony_elixir/core_test.exs     |  2 ++
 .../workspace_and_config_test.exs             | 27 +++++++++++++++++++
 6 files changed, 79 insertions(+), 7 deletions(-)

diff --git a/elixir/lib/symphony_elixir/agent_runner.ex b/elixir/lib/symphony_elixir/agent_runner.ex
index f99a2d9..3d37440 100644
--- a/elixir/lib/symphony_elixir/agent_runner.ex
+++ b/elixir/lib/symphony_elixir/agent_runner.ex
@@ -43,8 +43,10 @@ defmodule SymphonyElixir.AgentRunner do
         send_worker_runtime_info(codex_update_recipient, issue, worker_host, workspace)
 
         try do
-          with :ok <- Workspace.run_before_run_hook(workspace, issue, worker_host) do
-            run_codex_turns(workspace, issue, codex_update_recipient, opts, worker_host)
+          with :ok <- Workspace.run_before_run_hook(workspace, issue, worker_host),
+               :ok <- run_codex_turns(workspace, issue, codex_update_recipient, opts, worker_host),
+               :ok <- Workspace.run_completion_hook(workspace, issue, worker_host) do
+            :ok
           end
         after
           Workspace.run_after_run_hook(workspace, issue, worker_host)
diff --git a/elixir/lib/symphony_elixir/config/schema.ex b/elixir/lib/symphony_elixir/config/schema.ex
index c2ce38b..a8050a0 100644
--- a/elixir/lib/symphony_elixir/config/schema.ex
+++ b/elixir/lib/symphony_elixir/config/schema.ex
@@ -322,6 +322,7 @@ defmodule SymphonyElixir.Config.Schema do
     embedded_schema do
       field(:after_create, :string)
       field(:before_run, :string)
+      field(:completion, :string)
       field(:after_run, :string)
       field(:before_remove, :string)
       field(:timeout_ms, :integer, default: 60_000)
@@ -330,7 +331,7 @@ defmodule SymphonyElixir.Config.Schema do
     @spec changeset(%__MODULE__{}, map()) :: Ecto.Changeset.t()
     def changeset(schema, attrs) do
       schema
-      |> cast(attrs, [:after_create, :before_run, :after_run, :before_remove, :timeout_ms], empty_values: [])
+      |> cast(attrs, [:after_create, :before_run, :completion, :after_run, :before_remove, :timeout_ms], empty_values: [])
       |> validate_number(:timeout_ms, greater_than: 0)
     end
   end
diff --git a/elixir/lib/symphony_elixir/workspace.ex b/elixir/lib/symphony_elixir/workspace.ex
index 28ee2da..7e07b51 100644
--- a/elixir/lib/symphony_elixir/workspace.ex
+++ b/elixir/lib/symphony_elixir/workspace.ex
@@ -246,6 +246,28 @@ defmodule SymphonyElixir.Workspace do
     end
   end
 
+  @doc """
+  Runs the trusted completion hook after Codex succeeds.
+
+  Unlike `after_run`, this hook is part of the worker result. A missing command is disabled, while
+  a command failure or timeout propagates to the orchestrator and fails the worker attempt.
+  """
+  @spec run_completion_hook(Path.t(), map() | String.t() | nil, worker_host()) ::
+          :ok | {:error, term()}
+  def run_completion_hook(workspace, issue_or_identifier, worker_host \\ nil)
+      when is_binary(workspace) do
+    issue_context = issue_context(issue_or_identifier)
+    hooks = Config.settings!().hooks
+
+    case hooks.completion do
+      nil ->
+        :ok
+
+      command ->
+        run_hook(command, workspace, issue_context, "completion", worker_host)
+    end
+  end
+
   defp workspace_path_for_issue(safe_id, nil) when is_binary(safe_id) do
     Config.local_workspace_root()
     |> Path.join(safe_id)
diff --git a/elixir/test/support/test_support.exs b/elixir/test/support/test_support.exs
